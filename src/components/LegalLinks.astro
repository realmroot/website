---
interface Props {
  isChinese?: boolean;
}

const { isChinese = false } = Astro.props;
const prefix = isChinese ? '/zh-cn' : '';
---

<nav class="legal-links" aria-label={isChinese ? '条款与隐私' : 'Terms and privacy'}>
  <a href={`${prefix}/terms/`}>{isChinese ? '服务条款' : 'Terms of Service'}</a>
  <a href={`${prefix}/privacy/`}>{isChinese ? '隐私政策' : 'Privacy Policy'}</a>
</nav>

<style>
  .legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 16px;
    font-family: inherit;
    font-size: 10px;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: inherit;
    text-decoration: none;
    text-underline-offset: 4px;
  }

  a:hover {
    text-decoration: underline;
  }

  a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
    border-radius: 2px;
  }
</style>
