---
import { getCollection } from 'astro:content';
import type { Locale } from '../site';
import PhraseText from './PhraseText.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isChinese = locale === 'zh-CN';
const titleLines = isChinese
  ? ['让现有 API，', '成为 Agent 能力。']
  : ['Make existing APIs', 'Agent capabilities.'];
const posts = (await getCollection('blog'))
  .filter((post) => post.data.language === locale)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<section class="section-shell blog-hero">
  <p class="eyebrow"><span></span>{isChinese ? 'OpenAPI · Agent 能力 · 信任边界' : 'OpenAPI · Agent capability · Trust boundaries'}</p>
  <h1 class="heading-lines">{titleLines.map((line) => <span>{line}</span>)}</h1>
  <p>
    <PhraseText
      locale={locale}
      text={
        isChinese
          ? '关于如何发现现有 API、精确委托权限，并让 Agent 直接完成真实任务的产品与工程思考。'
          : 'Product and engineering notes on discovering existing APIs, delegating precise authority, and letting Agents complete real tasks directly.'
      }
    />
  </p>
</section>

<section class="section-shell blog-index">
  <div class="post-grid">
    {posts.map((post) => {
      const slug = post.id.replace(/^(en|zh-cn)\//, '');
      const href = isChinese ? `/zh-cn/blog/${slug}/` : `/blog/${slug}/`;
      return (
        <a class="post-card" href={href}>
          <div class="meta">
            <span>{post.data.publishedAt.toLocaleDateString(locale, { timeZone: 'UTC' })}</span>
            <span>{isChinese ? '阅读' : 'Read'} ↗</span>
          </div>
          <h3>{post.data.title}</h3>
          <p><PhraseText locale={locale} text={post.data.description} /></p>
        </a>
      );
    })}
  </div>
</section>
