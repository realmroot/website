---
import '../styles/global.css';
import LegalLinks from '../components/LegalLinks.astro';
import { copy, site, type Locale } from '../site';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  canonicalPath?: string;
  surface?: 'platform' | 'wallet';
  ogImage?: string;
}

const {
  title,
  description,
  locale = 'en',
  canonicalPath = Astro.url.pathname,
  surface = 'platform',
  ogImage = '/og.png',
} = Astro.props;
const t = copy[locale];
const isChinese = locale === 'zh-CN';
const isWallet = surface === 'wallet';
const walletLandingHref = isChinese ? '/zh-cn/wallet/' : '/wallet/';
const productLabel = isChinese ? '产品' : 'Products';
const languageHref = isChinese
  ? canonicalPath.replace(/^\/zh-cn/, '') || '/'
  : `/zh-cn${canonicalPath === '/' ? '/' : canonicalPath}`;
const canonical = new URL(canonicalPath, Astro.site);
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/assets/logo.png" type="image/png" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={isChinese ? 'en' : 'zh-CN'} href={languageHref} />
    <link rel="alternate" type="application/rss+xml" title="Realmroot Blog" href={isChinese ? '/zh-cn/rss.xml' : '/rss.xml'} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{isChinese ? '跳到主要内容' : 'Skip to content'}</a>
    <header class:list={['site-header', { 'wallet-header': isWallet }]}>
      <div class="nav-shell">
        <a class="brand" href={t.home} aria-label={isChinese ? 'Realmroot 首页' : 'Realmroot home'}>
          <img class="brand-mark" src="/assets/logo.png" width="28" height="26" alt="" aria-hidden="true" />
          <span>realmroot</span>
        </a>
        <nav class="desktop-nav" aria-label={isChinese ? '主导航' : 'Primary navigation'}>
          <div class="product-switcher">
            <button class="product-switcher-trigger" type="button" aria-haspopup="true">
              <span>{productLabel}</span>
              <span class="product-switcher-chevron" aria-hidden="true"></span>
            </button>
            <div class="product-switcher-menu" aria-label={productLabel}>
              <a class:list={['product-switcher-option', { active: !isWallet }]} href={t.home} aria-current={!isWallet ? 'page' : undefined}>
                <span class="product-switcher-mark realmroot-product-mark" aria-hidden="true"><img src="/assets/logo.png" width="24" height="22" alt="" /></span>
                <span class="product-switcher-copy">
                  <span class="product-switcher-name">Realmroot</span>
                  <span>{isChinese ? '工具平面 · 身份 · 信任' : 'Tool plane · identity · trust'}</span>
                </span>
                <span class="product-switcher-arrow" aria-hidden="true">→</span>
              </a>
              <a class:list={['product-switcher-option', { active: isWallet }]} href={walletLandingHref} aria-current={isWallet ? 'page' : undefined}>
                <span class="product-switcher-mark" aria-hidden="true">W</span>
                <span class="product-switcher-copy">
                  <span class="product-switcher-name">Wallet</span>
                  <span>{isChinese ? '预算 · x402 支付' : 'Budgets · x402 payments'}</span>
                </span>
                <span class="product-switcher-arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </div>
          {isWallet ? (
            <>
              <a href={`${walletLandingHref}#wallet`}>{isChinese ? '概览' : 'Overview'}</a>
              <a href={`${walletLandingHref}#controls`}>{isChinese ? '控制' : 'Controls'}</a>
              <a href={`${walletLandingHref}#flow`}>{isChinese ? '支付流程' : 'Payment flow'}</a>
            </>
          ) : (
            <>
              <a href={`${t.home}#agent-tool-plane`}>{t.nav.toolPlane}</a>
              <a href={`${t.home}#trust`}>{t.nav.trust}</a>
              <a href={isChinese ? '/zh-cn/docs/' : '/docs/'}>{t.nav.docs}</a>
            </>
          )}
          <a href={isChinese ? '/zh-cn/blog/' : '/blog/'}>{t.nav.blog}</a>
        </nav>
        <nav class="compact-nav" aria-label={isChinese ? '主导航' : 'Primary navigation'}>
          <details class="product-switcher product-switcher-compact">
            <summary>
              <span>{productLabel}</span>
              <span class="product-switcher-chevron" aria-hidden="true"></span>
            </summary>
            <div class="product-switcher-menu" aria-label={productLabel}>
              <a class:list={['product-switcher-option', { active: !isWallet }]} href={t.home} aria-current={!isWallet ? 'page' : undefined}>
                <span class="product-switcher-mark realmroot-product-mark" aria-hidden="true"><img src="/assets/logo.png" width="24" height="22" alt="" /></span>
                <span class="product-switcher-copy">
                  <span class="product-switcher-name">Realmroot</span>
                  <span>{isChinese ? '工具平面 · 身份 · 信任' : 'Tool plane · identity · trust'}</span>
                </span>
                <span class="product-switcher-arrow" aria-hidden="true">→</span>
              </a>
              <a class:list={['product-switcher-option', { active: isWallet }]} href={walletLandingHref} aria-current={isWallet ? 'page' : undefined}>
                <span class="product-switcher-mark" aria-hidden="true">W</span>
                <span class="product-switcher-copy">
                  <span class="product-switcher-name">Wallet</span>
                  <span>{isChinese ? '预算 · x402 支付' : 'Budgets · x402 payments'}</span>
                </span>
                <span class="product-switcher-arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </details>
          <a href={isWallet ? `${walletLandingHref}#controls` : (isChinese ? '/zh-cn/docs/' : '/docs/')}>
            {isWallet ? (isChinese ? '控制' : 'Controls') : t.nav.docs}
          </a>
        </nav>
        <div class="nav-actions">
          <a class="language-link" href={languageHref}>{isChinese ? 'EN' : '中文'}</a>
          <a class="button button-primary button-small" href={isWallet ? site.wallet : site.github}>
            {isWallet ? (isChinese ? '打开 Wallet' : 'Open Wallet') : t.nav.github}
          </a>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-grid">
        <div>
          <a class="brand footer-brand" href={t.home}>
            <img class="brand-mark" src="/assets/logo.png" width="28" height="26" alt="" aria-hidden="true" />
            <span>realmroot</span>
          </a>
          <p>{isWallet
            ? (isChinese ? '给 Agent 预算，而不是钱包密钥。' : 'Give Agents a budget, not your wallet keys.')
            : t.footer.statement}</p>
        </div>
        <div>
          <strong>{t.footer.product}</strong>
          <a href={t.home}>Realmroot</a>
          <a href={walletLandingHref}>Wallet</a>
          <a href={`${t.home}#agent-tool-plane`}>{t.nav.toolPlane}</a>
          <a href={`${t.home}#trust`}>{t.nav.trust}</a>
        </div>
        <div>
          <strong>{t.footer.resources}</strong>
          <a href={isChinese ? '/zh-cn/blog/' : '/blog/'}>{t.nav.blog}</a>
          <a href={isChinese ? '/zh-cn/docs/' : '/docs/'}>{t.nav.docs}</a>
          <a href={site.github}>GitHub</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} Realmroot</span>
        <LegalLinks isChinese={isChinese} />
        <span>{t.footer.legal}</span>
      </div>
    </footer>
  </body>
</html>
